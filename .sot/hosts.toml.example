# Ship of Tools declared topology — TEMPLATE. Grammar v2 (one parser:
# rust/protocol/src/topology.rs; one reader per box: `sotd topology`).
#
# Where it lives: the hub's own ~/.config/sot/hosts.toml is the canonical
# copy (written by the owner, on the hub). A box that shares the hub's home
# simply has it. Every other box fetches it with `sotd topology sync --hub
# <alias>` into its own config dir (~/.config/sot/hosts.toml,
# %LOCALAPPDATA%\sot\config\hosts.toml); the launcher runs that at every
# launch, naming the hub the copy it already has declares. A box that has
# never synced has no copy to name one, so the launcher falls back to its
# own configured backend host (`$SOT_HOST_NAME` / `$SOT_HOST`) for that
# first fetch; with neither, it launches with no remote hosts and says so
# in the supervisor log. `$SOT_HOSTS` overrides the path (tests, scratch
# daemons). There
# is no repo-local copy: this file is a template, not a search location.
#
# Read once at daemon start for the [monitor] list; at every launch for the
# tunnel plan. Editing it means a relaunch (tunnels are the launcher's) and
# a daemon restart (samplers are spawned from the list).
#
# The grammar is exactly what you see: `[section]` headers, `key = "string"`,
# `key = true|false`, `#` comments (whole-line or trailing). Anything else
# is an error naming the line and the offender.
#
# hub = "<host>"
#   Exactly one, and it must be a listed host. The hub runs the relay daemon
#   every comm session joins — ONE handle namespace. Its forward-tunnel port
#   on a frontend box is always 18743.
#
# [host.<name>]
#   A Ship of Tools host. The section key is the host's own `host_name()`
#   (hostname -s, lowercased, or $SOT_SELF_HOST) AND its ssh alias on every
#   box that dials it — one name, three uses, so it must be plain:
#   [a-z0-9][a-z0-9._-]*. Reachability (User, ProxyJump, HostName) is ssh's
#   business, in ~/.ssh/config, never here.
#   daemon   = true   runs sotd: frontends dial it (a tunnel per launch,
#                     port 18743 for the hub, then 18744.. in file order
#                     skipping the hub) and it owns session rows. Default false.
#   frontend = true   runs a frontend + launcher: it dials the hub and the
#                     hub never dials it (no reverse tunnel). Default false.
#   Neither flag: a shell host — it gets the hub's reverse relay tunnel
#   (sot-relay-tunnel@<name>, enabled on the hub from this list by `sotd
#   topology apply`, ADR 0028's Update) so sessions there can join, and
#   nothing else. The hub itself must be
#   `daemon = true` (it runs the relay daemon); a daemon that is also
#   `frontend` is dialled only by its own box's launcher, never from
#   elsewhere.
#
# [monitor]
#   Sampling targets for the Ctrl+M server-monitor drawer (ADR 0020) — NOT
#   hosts. `<label> = "<ssh target>"`; an empty target means the label. Any
#   box, user or OS with bash, /proc and (for GPU columns) nvidia-smi over
#   key-based ssh qualifies, whether or not it runs Ship of Tools; a host
#   above is sampled only if it is also listed here. The entry whose label
#   or target equals this box's host name is sampled locally.
#
# The example below is a real shape: a hub, two shell-only hosts, a frontend
# box, and a GPU box that runs no Ship of Tools. The hub reverse-tunnels to
# shell-a and shell-b; on `frontend-box` the launcher runs `sotd topology
# sync --hub hub` then `sotd topology plan` (tunnel hub 18743, dial hub
# tcp:127.0.0.1:18743, relay-endpoint tcp:127.0.0.1:18743); on any box
# `export SOT_RELAY_ENDPOINT="$(sotd topology relay-endpoint)"`.
#
# v1 keys (`default_host`; per host `ssh_alias`, `remote_repo`, `tcp_port`,
# `remote_socket`, `socket`, `remote_home`) still parse THIS release with
# one warning each naming the replacement — a file using any of them is a
# v1 file, and every host in it counts as `daemon = true` — and are deleted
# at the next rc.

hub = "hub"

[host.hub]
daemon = true

[host.shell-a]

[host.shell-b]

[host.frontend-box]
frontend = true

[monitor]
hub = ""
shell-a = ""
shell-b = ""
gpu-box = "other-user@gpu-box"
