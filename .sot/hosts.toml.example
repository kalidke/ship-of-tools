# Ship of Tools host registry — TEMPLATE (copy to hosts.toml and edit).
#
# The real hosts.toml is machine/user-specific and NOT committed (ADR 0030 §6):
#   cp .sot/hosts.toml.example .sot/hosts.toml     # repo-local override, or
#   ~/.config/sot/hosts.toml / %APPDATA%\sot\hosts.toml   # per-user config
#
# Discovery order: $SOT_HOSTS → <repo-root>/.sot/hosts.toml →
# $XDG_CONFIG_HOME/sot/hosts.toml or %APPDATA%\sot\hosts.toml.
# Format kept deliberately simple — section per host, scalar
# key = value lines — so the PowerShell launcher can parse it with
# regex without pulling in a TOML library.
#
# The frontend's `Mode::Hosts` lists every `[host.<name>]` section — every
# entry is a live connection at once (ADR 0042 slice L2a), not a single
# picked target, so Enter there just navigates the Sessions-mode cursor
# to that host's node. The LAUNCHER opens ONE SSH TUNNEL PER REMOTE entry
# (every `[host.<name>]` with an `ssh_alias` — ADR 0042 L2b design E), not
# just `default_host`; `default_host` below only picks which host the CLI
# `--socket`/`--tcp` overrides (env vars can override that choice) and may
# omit `tcp_port` (falls back to 18743/$SOT_TCP_PORT) for compatibility —
# every OTHER remote must set `tcp_port` itself. The launcher no longer
# reads any persisted "last picked host" from frontend state (that
# ADR-0015 mechanism — a `last_host` written to `state-<hostname>.toml` —
# is retired; the field now means something else entirely on the frontend
# side and the launcher doesn't read it at all).
#
# Frontend↔backend transport is SSH to a per-user remote socket. `tcp_port`
# below is the local forwarded port the native frontend dials; the remote side
# terminates at the Unix socket owned by the SSH user. Key-based auth to the
# backend host is a hard requirement (ADR 0030 §5).

default_host = "myserver"

[host.myserver]
# None of this project's hosts.toml parsers (Rust, PowerShell, bash) strip
# an inline comment -- a trailing `# ...` on an active key=value line
# becomes part of the value verbatim (see the required-tcp_port note
# above for what that does to a bare number). Comments below live on
# their OWN line, one per key, so this file is safe to copy verbatim.
#
# ssh_alias: entry in your ~/.ssh/config
ssh_alias = "myserver"
# remote_repo: project root the daemon serves
remote_repo = "/home/me/path/to/project"
# tcp_port: local side of the SSH forward -- required (default_host may omit; see above)
tcp_port = 18743
# remote_socket (optional; queried if omitted):
# remote_socket = "/run/user/<uid>/sot/sessions/sot.sock"
remote_home = "/home/me"

# A second remote — its OWN tunnel, opened alongside myserver's, not instead
# of it (ADR 0042 L2b design E). tcp_port is REQUIRED here (this isn't
# default_host): if it's missing, the launcher logs one line naming the
# host and skips just this one's tunnel, rather than failing the whole launch.
#
# [host.otherbox]
# ssh_alias = "otherbox"
# remote_repo = "/home/me/path/to/project"
# tcp_port = 18744
# remote_socket = "/run/user/<uid>/sot/sessions/sot.sock"
#
# "local" (this machine's own backend) needs NO entry here at all — every
# launch ensures a local sotd and the frontend always connects to it first,
# implicitly (ADR 0042 L2b). A [host.local] section is only for the rare
# case of overriding its derived socket/pipe path; nothing else on it
# (ssh_alias, tcp_port, ...) has any effect, since local is never tunneled.

# Hosts sampled for the Ctrl+M server-monitor drawer (ADR 0020). Each line is
# <display-name> = "<ssh-alias>". The host whose name (or alias) matches this
# machine's hostname is sampled locally (no SSH); the rest over `ssh <alias>`.
# nvidia-smi + /proc are world-readable, so no sudo/privileges are needed on
# any host. Remove a line to stop monitoring that host.
#
# READ ONCE, AT DAEMON START. Editing this section while the backend is running
# has no effect until it restarts. Omit the section entirely and only this
# machine is sampled — the [host.*] entries above are connection targets and are
# not monitored implicitly.
#
# [monitor]
# myserver = "myserver"
# otherbox = "otherbox"
