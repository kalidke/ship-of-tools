# Ship of Tools frontend settings — TEMPLATE (copy to settings.toml and edit).
#
# The real settings.toml is machine/user-specific and NOT committed
# (ADR 0030 §6): copy this next to it, or to ~/.config/sot/settings.toml.
#
# Discovery order: $SOT_SETTINGS → <repo-root>/.sot/settings.toml →
# $HOME/.config/sot/settings.toml → built-in defaults.
# Any value missing or out-of-range silently falls back to the default;
# the chrome should never crash because the user wrote a malformed
# settings file.
#
# Sibling to .sot/keybindings.toml — the same layered discovery
# pattern, kept in a separate file for single-responsibility.

[layout]
# Layout is preset-based (ADR 0014): "auto" (DEFAULT) resolves by the primary
# monitor's aspect ratio at startup (> 1.9 → ultrawide, 1.5–1.9 → laptop,
# < 1.5 → portrait); naming a preset locks it regardless of aspect.
# preset = "auto"   # auto | ultrawide | laptop | portrait

# Each preset is tunable via its sub-table — columns (named slots, left to
# right), fractional widths (renormalised to sum to 1.0), and the shared
# bottom drawer. Full schema: docs/src/ref/config.md.
# [layout.laptop]
# columns = "nav,preview,llm"
# widths = "0.18,0.32,0.50"
# drawer = "repl"
# drawer_height = 0.40

[terminal]
# Command auto-run in the Terminal drawer when the supervisor respawns the
# frontend after a self-relaunch (--relaunched, ADR 0017). The trailing
# positional `/sot-fe-session-start` is submitted as the resumed session's
# FIRST turn, invoking the project skill that re-arms the fast-comm
# fe-inbox Monitor + catches the relaunch deaf-window gap.
# --permission-mode auto matches the documented default
# (docs/src/ref/config.md + the sot-setup skill): without it the resumed
# drawer session stalls on permission prompts before its bootstrap turn.
resume_command = "claude --permission-mode auto --continue /sot-fe-session-start"

[sessions]
# Directory the Sessions-mode "create workspace" picker (nav pane → new
# session) starts browsing from. This is a BACKEND path — the picker lists
# the daemon host's filesystem, not the frontend's — so point it at your
# dev root so "new session" opens there instead of $HOME.
new_session_root = "/home/me/dev"

[font]
# Default text-scale multiplier at startup, used only when this machine has
# no persisted zoom yet (Ctrl+= / Ctrl+- / Ctrl+0 persist per host and always
# win). Unset: a built-in monitor tier applies — displays >= 3440 px wide
# default to 1.1, others 1.0.
# scale = 1.1

[gpu]
# Which adapter to request from wgpu: "low" (integrated, DEFAULT) or "high"
# (discrete). The frontend draws glyph quads and image blits, which an
# integrated GPU handles fine, so it defaults to low power. On a
# hybrid-graphics laptop, asking for the discrete GPU keeps it awake for the
# whole session (~11 W measured on an idle RTX 4070) because an active
# surface stops it power-gating. Set "high" on a desktop with a real GPU, or
# if the integrated adapter renders incorrectly. No-op on single-adapter
# machines. BINDS AT STARTUP — restart the frontend for a change to apply.
# power_preference = "high"

[display]
# While fullscreen, keep a steady vsync-paced redraw cadence (DEFAULT true,
# unchanged behaviour) instead of the efficient on-demand idle tick. Fixes
# brightness pumping on a VRR/adaptive-sync OLED panel, where borderless
# fullscreen disengages DWM composition and the ~1 fps idle present drives
# the panel into the 1-10 Hz low-framerate-compensation band. Costs
# continuous GPU while fullscreen. There is no trustworthy VRR-detection
# API, so set this to false yourself on a fixed-refresh panel (most
# laptops) to get the efficient idle path fullscreen too.
# fullscreen_vsync_pin = false
