# Ship of Tools frontend keybindings — TEMPLATE (copy to keybindings.toml).
#
# The real keybindings.toml is a user preference and NOT committed
# (ADR 0030 §6); absent, every action falls through to built-in defaults.
#
# Discovery order: $SOT_KEYBINDINGS → <repo-root>/.sot/keybindings.toml
# (this file) → $HOME/.config/sot/keybindings.toml → built-in defaults.
# Each action's chord(s) here override the built-in default; absent actions
# fall through to the default. Multiple chords per action: use a list.
#
# Chord grammar: zero or more modifier+ tokens followed by one key.
#   modifiers: ctrl, alt (option, legacy meta), shift, super (cmd, command, win)
#              primary = Command on macOS, Control elsewhere (case-insensitive)
#   key:       a single character ("=", "z", "+") OR a NamedKey
#              (Tab, Enter, Escape, Space, Backspace, Delete, ArrowUp,
#              ArrowDown, ArrowLeft, ArrowRight, PageUp, PageDown,
#              Home, End)
#
# Letters and named keys match Shift exactly: r and Shift+r are distinct.
# Punctuation uses the typed character: Alt++ binds plus, Alt+= binds equals.
# macOS labels distinguish Control (⌃), Command (⌘), Option (⌥), and Shift (⇧).
#
# An override here REPLACES that action's WHOLE default chord list, not just
# adds to it (finding 5, v0.6.5 macOS field report) -- e.g. an old
# `focus.pane_left = "Alt+ArrowLeft"` line hides the CURRENT built-in default
# (⌘Arrow on macOS) rather than sitting alongside it. Delete a line here once
# you no longer need it: an upgrade that changes a built-in default never
# reaches you while a stale override of that same action is still active.

[keys]
# Maximise the focused pane to fill the window.
pane.maximize = "Alt+="
# Restore the full layout, one layer per press: un-maximize first, then exit
# wide-preview (the latter only from nav/preview focus with no modal up).
# Otherwise Esc passes through to the pty / edit mode / etc.
pane.restore = "Escape"
# Wide-preview toggle (global): hide the LLM column and hand its width to the
# preview pane — nav keeps its width. Toggle again to bring the LLM back.
# Default Alt++ = the shifted neighbour of Alt+= (maximize). Avoid Alt+z:
# the NVIDIA overlay grabs it system-wide before the app sees it.
layout.wide_preview = "Alt++"
# Sessions picker — commit the cursored directory as a new workspace.
#   session.create      → start the comm-aware agent (ccb) in the pane
#   session.create_bare → bare session, NO LLM agent (plain shell/REPL)
# Enter and Shift+Enter are distinct chords.
session.create = "Enter"
session.create_bare = "Shift+Enter"
# Mode switches (active only in nav focus — single-char chords stay literal
# text in the pty / editor / prompts).
mode.files = "f"
mode.modules = "m"
mode.sessions = "s"
mode.hosts = "h"
# Files mode: show/hide hidden dotfiles (nav focus only). Toggling collapses
# the tree to its root; deeper dirs pick up the change on next expand.
files.toggle_hidden = "."
# Drawer toggles (global): REPL / Terminal / Monitor panes.
drawer.repl = "Primary+j"
drawer.terminal = "Primary+t"
drawer.monitor = "Primary+m"
# Spatial pane focus (global, 4-way). Keep disjoint from plain arrows
# (per-pane nav) and Shift+Arrow (workspace cycle).
focus.pane_left = "Primary+ArrowLeft"
focus.pane_right = "Primary+ArrowRight"
focus.pane_up = "Primary+ArrowUp"
focus.pane_down = "Primary+ArrowDown"
# Cycle the active workspace (global; ignored while editing a file).
workspace.cycle_next = "Shift+ArrowRight"
workspace.cycle_prev = "Shift+ArrowLeft"
# Global chrome.
quit = "Primary+q"               # nav focus only (won't fire in the pty panes)
# NOTE: on macOS the built-in default is actually the bare Cmd+/, not
# Primary+? applied literally -- Cmd+Shift+/ is the system's own reserved
# Help-menu shortcut (finding 4). Setting this line active on a Mac
# reintroduces that conflict; leave it out there unless you want that.
help.toggle = "Primary+?"        # five-second pane overlay; again opens Help
drawer.help = "F1"              # open/close the persistent Help drawer
view.fullscreen = "F11"
transport.reconnect = "F5"
# Font scale. "=" and shifted "+" both zoom in; "-" and "_" both zoom out.
font.scale_up = ["Primary+=", "Primary++"]
font.scale_down = ["Primary+-", "Primary+_"]
font.scale_reset = "Primary+0"
