# Ship of Tools backend daemon — systemd user unit TEMPLATE (ADR 0030 §3).
#
# Installers substitute the @TOKENS@ and place the result at
# ~/.config/systemd/user/sotd.service, then:
#   systemctl --user daemon-reload && systemctl --user enable --now sotd
#   loginctl enable-linger $USER    # keep it alive without an open session
#
# Token values:
#   @SOT_BIN@          dev fleet: <repo>/rust/target/release/sotd
#                      public install: ~/.local/share/sot/bin/sotd (ADR 0030 §4)
#   @SOT_APPLY@        public install: ~/.local/share/sot/bin/sot-apply
#                      dev fleet: any path (may not exist — the '-' prefix
#                      tolerates a missing executable, so dev units are fine)
#   @SOT_PROJECT_ROOT@ the project the daemon serves
#
# Default transport is the per-user socket derived from `--label sot`
# (`/run/user/<uid>/sot/sessions/sot.sock` on normal Linux hosts). Remote FEs
# should forward a local TCP port to that socket over SSH rather than targeting
# a machine-wide remote TCP bind.

[Unit]
Description=Ship of Tools backend daemon (sotd)
# ADR 0038: the sot-tmux keeper owns the tmux server in its own cgroup, so a
# sotd restart can never kill the sessions. Wants= (NOT Requires=/PartOf= —
# no stop propagation in either direction, and sotd must still run where the
# keeper is absent: macOS, --no-service installs; the daemon then warns and
# falls back to the legacy implicit server). After= orders the boot so the
# default-workspace create finds the socket present; the daemon additionally
# starts the keeper on demand if the socket is ever missing.
Wants=sot-tmux.service
After=default.target network-online.target sot-tmux.service
StartLimitIntervalSec=0

[Service]
Type=simple
# The single systemd-side apply owner (ADR 0030 Phase C3): consumes an armed
# pending update — fast offline pointer flip, no network/Julia — on every
# start, so `update.apply`'s exit and plain restarts/reboots both come back
# on the new version. FAIL-OPEN twice over: the script always exits 0, and
# the '-' prefix tolerates even a missing/broken script — a bad update path
# must never keep the daemon down.
ExecStartPre=-@SOT_APPLY@
ExecStart=@SOT_BIN@ --project-root @SOT_PROJECT_ROOT@ --label sot
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
