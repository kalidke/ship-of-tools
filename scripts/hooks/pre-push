#!/bin/bash
# Inspect exact local Git objects; bound history by what this destination advertises.
set -u
set -o pipefail
export LC_ALL=C GIT_NO_LAZY_FETCH=1 GIT_NO_REPLACE_OBJECTS=1
unset GIT_CONFIG
pg_tmp=$(mktemp -d "${TMPDIR:-/tmp}/sot-publish.XXXXXX") || { echo 'pre-push: cannot create scratch directory; refusing the push' >&2; exit 1; }
pg_tmp=$(cd "$pg_tmp" && pwd -P) || exit 1
trap 'rm -rf "${pg_tmp:?}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
here=$(cd "${BASH_SOURCE[0]%/*}" && pwd -P) || exit 1
pg_abort() { printf 'pre-push: %s; refusing the push\n' "$1" >&2; exit 1; }
[ -f "$here/publish-guard-lib.sh" ] && [ -r "$here/publish-guard-lib.sh" ] || pg_abort 'cannot load policy validator'
. "$here/publish-guard-lib.sh" 2>/dev/null || pg_abort 'cannot load policy validator'
for validator in pg_fail pg_list pg_list_encoding pg_no_reparse; do
    declare -F "$validator" > /dev/null || pg_abort 'policy validator is incomplete'
done
pg_list || pg_abort 'policy validation failed'
[ "${SOT_PUBLISH_CHAIN_ACTIVE:-}" != 1 ] || pg_fail 'hook chain cycle'
cat > "$pg_tmp/input" || pg_fail 'cannot preserve push input'

zero() { case "$1" in ''|*[!0]*) return 1 ;; *) return 0 ;; esac; }
oid_ok() { case "$1" in ''|*[!0-9a-f]*) return 1 ;; *) return 0 ;; esac; }
# --batch-all-objects enumerates the local object store without visiting promisor remotes.
# Every later read is preceded by membership here; no missing object is handed to a lazy-fetching reader.
git cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' > "$pg_tmp/objects" 2>/dev/null ||
    pg_fail 'cannot enumerate local objects'
# The push input's old ids and what the destination advertises now (one ls-remote on the URL git
# hands the hook, which never fetches objects) bound history. Ids missing locally give no exclusion.
: > "$pg_tmp/old" || pg_fail 'cannot prepare history queue'
: > "$pg_tmp/updates" || pg_fail 'cannot prepare object queue'
while read -r lref local_oid rref old_oid extra; do
    [ -n "$old_oid" ] && [ -z "$extra" ] && oid_ok "$local_oid" && oid_ok "$old_oid" || pg_fail 'invalid push input'
    printf '%s %s %s %s\n' "$lref" "$local_oid" "$rref" "$old_oid" >> "$pg_tmp/updates" || pg_fail 'cannot queue pushed object'
    if ! zero "$old_oid"; then printf '%s\n' "$old_oid" >> "$pg_tmp/old" || pg_fail 'cannot queue old object'; fi
done < "$pg_tmp/input"
[ -n "${2:-}" ] || pg_fail 'cannot determine destination'
# ls-remote applies insteadOf again and reads a configured remote named like a bare-word URL, so it
# must dial exactly the URL the push uses.
reached=$(git ls-remote --get-url -- "$2" 2>/dev/null) || pg_fail 'cannot resolve destination'
[ "$reached" = "$2" ] || pg_fail 'destination advertisement would come from another URL'
git ls-remote -- "$2" > "$pg_tmp/advertised" 2>/dev/null || pg_fail 'cannot read destination advertisement'
# An empty advertisement (an empty remote) is valid and excludes nothing; the walk below refuses a
# first field that is not an object id.
awk -F '\t' '{ print $1 }' "$pg_tmp/advertised" >> "$pg_tmp/old" || pg_fail 'cannot queue advertised objects'
scanner_failed() {
    local message
    { IFS= read -r message < "$pg_tmp/failure"; } 2>/dev/null || pg_fail 'scanner failed'
    pg_fail "$message"
}
[ -f "$here/publish-guard-scan.awk" ] && [ -r "$here/publish-guard-scan.awk" ] || pg_fail 'scanner failed'
run_scanner() {
    local input=$1 status
    shift
    # An empty program must not become awk's successful default action.
    : > "$pg_tmp/scanner-ok" || pg_fail 'scanner failed'
    awk -v dir="$pg_tmp" "$@" -f "$here/publish-guard-scan.awk" "$input" > /dev/null 2>/dev/null || scanner_failed
    { IFS= read -r status < "$pg_tmp/scanner-ok"; } 2>/dev/null || pg_fail 'scanner failed'
    [ "$status" = ok ] || pg_fail 'scanner failed'
}
# Every read round is preceded by a catalog check of exactly its frontier. The
# catalog supplies types, never new requests: unrelated local objects stay unread.
read_round() {
    local phase=$1 frontier=$2 next_frontier=$3 roots=${4:-} late=${5:-} id rc=0
    : > "$pg_tmp/requests" && : > "$next_frontier" || pg_fail 'cannot prepare object queue'
    run_scanner "$pg_tmp/empty" -v action=prepare -v phase="$phase" -v frontier="$frontier" -v roots="$roots"
    [ -s "$pg_tmp/requests" ] || return 0
    if [ "$phase" = trees ]; then
        git cat-file --batch='%(objectname) %(objecttype) %(objectsize)' < "$pg_tmp/requests" > "$pg_tmp/round-bytes" 2>/dev/null || rc=$?
    else
        git cat-file --batch < "$pg_tmp/requests" > "$pg_tmp/round-bytes" 2>/dev/null || rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
        # Locate the interrupted request in the bytes already produced, without
        # retrying the reader or matching any content after its failure.
        od -An -v -tu1 < "$pg_tmp/round-bytes" > "$pg_tmp/round-text" 2>/dev/null || pg_fail 'cannot normalize object bytes'
        run_scanner "$pg_tmp/round-text" -v action=failed -v phase="$phase"
        IFS= read -r id < "$pg_tmp/requests" || pg_fail 'scanner failed'
        [ "$phase" != trees ] || pg_fail "cannot read tree $id"
        pg_fail "cannot read object $id"
    fi
    if [ "$phase" = blobs ]; then
        tr '\000' '\n' < "$pg_tmp/round-bytes" > "$pg_tmp/round-text" 2>/dev/null || pg_fail 'cannot normalize object bytes'
    else
        od -An -v -tu1 < "$pg_tmp/round-bytes" > "$pg_tmp/round-text" 2>/dev/null || pg_fail 'cannot normalize object bytes'
    fi
    run_scanner "$pg_tmp/round-text" -v action=read -v phase="$phase" -v frontier="$frontier" \
        -v next_frontier="$next_frontier" -v late="$late"
}
walk_rounds() {
    local phase=$1 frontier=$2 roots=${3:-} late=${4:-} next_frontier
    while :; do
        [ -f "$frontier" ] && [ -r "$frontier" ] || pg_fail 'scanner failed'
        [ -s "$frontier" ] || break
        round=$((round + 1)); next_frontier="$pg_tmp/frontier.$round"
        read_round "$phase" "$frontier" "$next_frontier" "$roots" "$late"
        frontier=$next_frontier
    done
}
: > "$pg_tmp/excluded" && : > "$pg_tmp/seen" && : > "$pg_tmp/blobs" && : > "$pg_tmp/pushed" && : > "$pg_tmp/empty" ||
    pg_fail 'cannot create object cache'
round=0
walk_rounds old "$pg_tmp/old"
run_scanner "$pg_tmp/empty" -v action=refs -v next_frontier="$pg_tmp/pushed"
frontier="$pg_tmp/pushed"
while [ -s "$frontier" ]; do
    round=$((round + 1)); roots="$pg_tmp/roots.$round"; late="$pg_tmp/late.$round"
    : > "$roots" && : > "$late" || pg_fail 'cannot prepare object queue'
    walk_rounds new "$frontier" "$roots"
    walk_rounds trees "$roots" "" "$late"
    # Raw file-mode entries can target nonblobs. Dispatch those through the same
    # selected-object walk rather than assuming that their stored type is blob.
    frontier=$late
done
# Published blobs are included whenever a selected snapshot retains them.
read_round blobs "$pg_tmp/blobs" "$pg_tmp/blob-end"

common=$(git rev-parse --git-common-dir 2>/dev/null) || pg_fail 'cannot locate common Git directory'
common=$(cd "$common" && pwd -P) || pg_fail 'cannot resolve common Git directory'
chain="$common/hooks/pre-push.local"
# A directly configured external copy retains the old default-slot chaining contract.
if [ -x "$common/hooks/pre-push" ] && [ ! "$common/hooks/pre-push" -ef "${BASH_SOURCE[0]}" ]; then
    # The persistent shim marks its invocation; an external guard instead chains to the default slot.
    [ "${SOT_PUBLISH_SHIM:-}" = 1 ] || chain="$common/hooks/pre-push"
fi
if [ -x "$chain" ]; then
    [ ! "$chain" -ef "${BASH_SOURCE[0]}" ] || pg_fail 'hook chain cycle'
    [ ! "$chain" -ef "$common/hooks/pre-push" ] || [ "${SOT_PUBLISH_SHIM:-}" != 1 ] || pg_fail 'hook chain cycle'
    SOT_PUBLISH_CHAIN_ACTIVE=1 "$chain" "$@" < "$pg_tmp/input"
    exit $?
fi
exit 0
