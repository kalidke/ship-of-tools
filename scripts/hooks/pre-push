#!/bin/bash
# Inspect exact local Git objects, never patches or a remote-tracking namespace.
set -u
set -o pipefail
export LC_ALL=C GIT_NO_LAZY_FETCH=1 GIT_NO_REPLACE_OBJECTS=1
unset GIT_CONFIG
pg_tmp=$(mktemp -d "${TMPDIR:-/tmp}/sot-publish.XXXXXX") || { echo 'pre-push: cannot create scratch directory; refusing the push' >&2; exit 1; }
pg_tmp=$(cd "$pg_tmp" && pwd -P) || exit 1
trap 'rm -rf "${pg_tmp:?}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
here=$(cd "${BASH_SOURCE[0]%/*}" && pwd -P) || exit 1
pg_abort() { printf 'pre-push: %s; refusing the push\n' "$1" >&2; exit 1; }
[ -f "$here/publish-guard-lib.sh" ] && [ -r "$here/publish-guard-lib.sh" ] || pg_abort 'cannot load policy validator'
. "$here/publish-guard-lib.sh" 2>/dev/null || pg_abort 'cannot load policy validator'
for validator in pg_fail pg_list pg_list_encoding pg_no_reparse; do
    declare -F "$validator" > /dev/null || pg_abort 'policy validator is incomplete'
done
pg_list || pg_abort 'policy validation failed'
[ "${SOT_PUBLISH_CHAIN_ACTIVE:-}" != 1 ] || pg_fail 'hook chain cycle'
cat > "$pg_tmp/input" || pg_fail 'cannot preserve push input'

scan() { # $1 is a safe object/ref label; $2 contains bytes (never shell text).
    local rc line
    tr '\000' '\n' < "$2" > "$pg_tmp/text" || pg_fail 'cannot normalize object bytes'
    awk -v policy="$pg_tmp/list" '
        BEGIN {
            n=0; na=0; nd=0
            while ((r=(getline s < policy)) > 0) {
                n++; sub(/\r$/, "", s)
                if (s == "" || substr(s,1,1) == "#") continue
                if (substr(s,1,1) == "!") { if (length(s)>1) a[++na]=tolower(substr(s,2)); continue }
                d[++nd]=tolower(s); ln[nd]=n
            }
            close(policy)
            if (r < 0) exit 2
        }
        {
            s=tolower($0)
            for (j=1;j<=na;j++) while ((p=index(s,a[j])) > 0) s=substr(s,1,p-1) substr(s,p+length(a[j]))
            for (j=1;j<=nd;j++) if (index(s,d[j])) { print ln[j]; exit 1 }
        }
    ' "$pg_tmp/text" > "$pg_tmp/match"
    rc=$?
    case $rc in
        0) ;;
        1) IFS= read -r line < "$pg_tmp/match" || pg_fail 'scanner failed'
           pg_fail "$1 holds the list entry at line $line" ;;
        *) pg_fail 'scanner failed' ;;
    esac
}
zero() { case "$1" in ''|*[!0]*) return 1 ;; *) return 0 ;; esac; }
oid_ok() { case "$1" in ''|*[!0-9a-f]*) return 1 ;; *) return 0 ;; esac; }
# --batch-all-objects enumerates the local object store without visiting promisor remotes.
# Every later read is preceded by membership here; no missing object is handed to a lazy-fetching reader.
git cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' > "$pg_tmp/objects" 2>/dev/null ||
    pg_fail 'cannot enumerate local objects'
mkdir "$pg_tmp/seen" "$pg_tmp/excluded" "$pg_tmp/index" || pg_fail 'cannot create object cache'
# Bucket the local catalog once; Bash 3.2 needs neither an associative array nor one file per object.
awk -v dir="$pg_tmp/index" '
    { p=dir "/" substr($1,1,2)
      if (last != "" && last != p) { if (close(last) != 0) exit 1 }
      print $0 >> p; last=p }
    END { if (last != "" && close(last) != 0) exit 1 }
' "$pg_tmp/objects" || pg_fail 'cannot index local objects'
local_type() {
    oid_ok "$1" || pg_fail 'invalid object id'
    kind=
    if [ -f "$pg_tmp/index/${1:0:2}" ]; then
        kind=$(awk -v id="$1" '$1 == id { print $2 }' "$pg_tmp/index/${1:0:2}") || pg_fail 'cannot look up local object'
    fi
}
object_type() {
    local_type "$1"
    case "$kind" in commit|tree|blob|tag) ;; *) pg_fail "object $1 is unavailable locally" ;; esac
}
raw() {
    object_type "$1"
    git cat-file "$kind" "$1" > "$pg_tmp/raw" 2>/dev/null || pg_fail "cannot read object $1"
}
# Only this destination's advertised old ids may bound history. Missing old ids give no exclusion.
: > "$pg_tmp/old" || pg_fail 'cannot prepare history queue'
ordinal=0
while read -r lref local_oid rref old_oid extra; do
    ordinal=$((ordinal + 1))
    [ -n "$old_oid" ] && [ -z "$extra" ] && oid_ok "$local_oid" && oid_ok "$old_oid" || pg_fail 'invalid push input'
    if ! zero "$old_oid"; then printf '%s\n' "$old_oid" >> "$pg_tmp/old" || pg_fail 'cannot queue old object'; fi
done < "$pg_tmp/input"
while IFS= read -r id; do
    [ ! -e "$pg_tmp/excluded/$id" ] || continue
    oid_ok "$id" || pg_fail 'invalid old object id'
    local_type "$id"
    case "$kind" in commit|tag) ;; *) continue ;; esac
    : > "$pg_tmp/excluded/$id" || pg_fail 'cannot cache old object'
    raw "$id"
    if [ "$kind" = tag ]; then
        sed -n '1s/^object //p' "$pg_tmp/raw" >> "$pg_tmp/old" || pg_fail 'cannot read old tag target'
    else
        sed -n '/^$/q; s/^parent //p' "$pg_tmp/raw" >> "$pg_tmp/old" || pg_fail 'cannot read old parents'
    fi
done < "$pg_tmp/old"

: > "$pg_tmp/queue" || pg_fail 'cannot prepare object queue'
# Trees carry a path context: a shared tree can appear under two different directory names.
scan_tree() {
    local tree_id=$1 prefix=$2 entry header path mode type child extra
    object_type "$tree_id"
    [ "$kind" = tree ] || pg_fail "invalid tree object $tree_id"
    git ls-tree -z "$tree_id" > "$pg_tmp/tree.$tree_id" 2>/dev/null || pg_fail "cannot read tree $tree_id"
    while IFS= read -r -d '' entry; do
        header=${entry%%$'\t'*}; path=${entry#*$'\t'}
        [ "$path" != "$entry" ] || pg_fail "invalid tree $tree_id"
        path="$prefix$path"
        printf '%s' "$path" > "$pg_tmp/path" || pg_fail 'cannot prepare tree path'
        scan "tree $tree_id" "$pg_tmp/path"
        read -r mode type child extra <<< "$header"
        oid_ok "$child" && [ -z "$extra" ] || pg_fail "invalid tree $tree_id"
        case "$mode:$type" in
            160000:commit)
                printf '%s\n' "$child" > "$pg_tmp/gitlink" || pg_fail 'cannot prepare gitlink'
                scan "tree $tree_id" "$pg_tmp/gitlink" ;;
            040000:tree|40000:tree) scan_tree "$child" "$path/" ;;
            100644:blob|100755:blob|120000:blob) printf '%s\n' "$child" >> "$pg_tmp/queue" || pg_fail 'cannot queue blob' ;;
            *) pg_fail "invalid tree entry in $tree_id" ;;
        esac
    done < "$pg_tmp/tree.$tree_id"
}
ordinal=0
while read -r lref local_oid rref old_oid extra; do
    ordinal=$((ordinal + 1))
    zero "$local_oid" && continue
    case "$rref" in refs/heads/*) namespace=branch ;; refs/tags/*) namespace=tag ;; *) namespace=ref ;; esac
    printf '%s\n' "$rref" > "$pg_tmp/ref" || pg_fail 'cannot read destination ref'
    scan "$namespace update $ordinal (object $local_oid)" "$pg_tmp/ref"
    printf '%s\n' "$local_oid" >> "$pg_tmp/queue" || pg_fail 'cannot queue pushed object'
done < "$pg_tmp/input"
# Replacement objects and graft/shallow history cannot hide a parent: traversal reads raw parent headers itself.
while IFS= read -r id; do
    oid_ok "$id" || pg_fail 'invalid reachable object id'
    [ ! -e "$pg_tmp/seen/$id" ] || continue
    : > "$pg_tmp/seen/$id" || pg_fail 'cannot cache selected object'
    object_type "$id"
    [ "$kind" != commit ] || [ ! -e "$pg_tmp/excluded/$id" ] || continue
    raw "$id"
    case "$kind" in
        commit)
            scan "commit $id" "$pg_tmp/raw"
            sed -n '/^$/q; s/^tree //p; s/^parent //p' "$pg_tmp/raw" >> "$pg_tmp/queue" || pg_fail "cannot read commit $id" ;;
        tag)
            scan "tag object $id" "$pg_tmp/raw"
            target=$(sed -n '1s/^object //p' "$pg_tmp/raw") || pg_fail "cannot read tag $id"
            oid_ok "$target" || pg_fail "invalid tag object $id"
            printf '%s\n' "$target" >> "$pg_tmp/queue" || pg_fail 'cannot queue tag target' ;;
        blob) scan "blob $id" "$pg_tmp/raw" ;;
        tree) scan_tree "$id" "" ;;
    esac
done < "$pg_tmp/queue"

common=$(git rev-parse --git-common-dir 2>/dev/null) || pg_fail 'cannot locate common Git directory'
common=$(cd "$common" && pwd -P) || pg_fail 'cannot resolve common Git directory'
chain="$common/hooks/pre-push.local"
# A directly configured external copy retains the old default-slot chaining contract.
if [ -x "$common/hooks/pre-push" ] && [ ! "$common/hooks/pre-push" -ef "${BASH_SOURCE[0]}" ]; then
    # The persistent shim marks its invocation; an external guard instead chains to the default slot.
    [ "${SOT_PUBLISH_SHIM:-}" = 1 ] || chain="$common/hooks/pre-push"
fi
if [ -x "$chain" ]; then
    [ ! "$chain" -ef "${BASH_SOURCE[0]}" ] || pg_fail 'hook chain cycle'
    [ ! "$chain" -ef "$common/hooks/pre-push" ] || [ "${SOT_PUBLISH_SHIM:-}" != 1 ] || pg_fail 'hook chain cycle'
    SOT_PUBLISH_CHAIN_ACTIVE=1 "$chain" "$@" < "$pg_tmp/input"
    exit $?
fi
exit 0
