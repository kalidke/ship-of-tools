#!/usr/bin/env bash
# sot-fe — drive the Ship of Tools frontend(s) with an imperative UI command from
# the backend (ADR 0025, op::FE_COMMAND). A BE-side CLI: it frames an
# `fe.command.send` request, sends it to the running sotd daemon over its
# socket (no comm relay, no FE LLM), and the daemon re-emits it as an
# `fe.command` evt. The FE shows the target in place when it is already on
# that workspace and otherwise badges it (see preview below). With no --fe, the daemon resolves delivery to the ACTIVE
# frontend — whichever FE last reported real keyboard/mouse input
# (`fe.presence`), within a 5-minute window — and delivers to that ONE
# connection exclusively; it falls back to broadcasting to every attached FE
# only when none qualifies. --fe <host> always scopes delivery to the
# frontend on that host (wire `target` = `fe@<host>`, the address every
# frontend declares as its hello `name`), overriding the active-frontend
# resolution.
#
# Usage:
#   sot-fe preview <workspace> <path> [--urgent] [--fe <host>] [--roi x,y,w,h]
#                                     [--caption <text>]
#   sot-fe reveal  <workspace> <path> [--urgent] [--fe <host>] [--caption <text>]
#   sot-fe goto    <workspace>        [--boot] [--fe <host>]
#   sot-fe mode    <mode>             [--fe <host>]
#   sot-fe notify  <text> [--level <l>] [--ws <workspace>] [--fe <host>]
#   sot-fe open-url <http(s)-url>                  [--fe <host>]
#   sot-fe docs    <workspace> <abs-path>          [--fe <host>]
#   sot-fe relaunch [--fe <host>] [--converge]
#   sot-fe repl run  <workspace> <path>            [--fresh] [--timeout <s>] [--origin <who>]
#   sot-fe repl eval <workspace> (--code <c> | --stdin) [--timeout <s>] [--origin <who>]
#   sot-fe repl interrupt <workspace>              [--timeout <s>]
#   sot-fe repl status [<workspace>]               [--timeout <s>]
#   sot-fe type   <workspace> [<text>] [--stdin] [--enter] [--origin <who>] [--timeout <s>]
#   sot-fe screen <workspace>                      [--timeout <s>]
#   sot-fe version                                 [--endpoint <ep>] [--timeout <s>]
#   sot-fe reauth <account>                        [--timeout <s>]
#
#   preview  — preview <path> and expand the file tree to it. If the FE is
#              already on <workspace> it happens at once; otherwise it is
#              badged and shown when the user next visits <workspace>. Only
#              --urgent with --fe switches the view now.
#   reveal   — the same as preview (one code path in the FE); --roi and
#              --caption apply to either.
#   goto     — switch the FE to <workspace> (no path).
#   mode     — switch the FE's active mode (files | modules | project | ...).
#   notify   — surface a one-line notice (optionally scoped to a workspace).
#   open-url — open an http(s) URL in the FE machine's OS BROWSER (the FE
#              just opens it). Before opening, the FE arms a loopback proxy
#              for the URL's port WHERE IT CAN: a remote, proxy-capable FE
#              (launched with --tcp) binds a local listener that tunnels the
#              port back to the daemon; a local FE, or one with no proxy
#              manager, is a no-op and the URL must already resolve on its
#              own. A tab that opens to a refused connection means THAT
#              frontend has no proxy for the port — not that nothing was
#              sent. Opens on the active FE by default (see --fe below); use
#              --fe to target a specific one instead.
#   docs     — open a LOCAL .html/site (ABSOLUTE backend path) in the FE's OS
#              BROWSER via docs.open (the `W` key, backend-triggered): the FE
#              serves the file from backend disk over the forwarded site_serve
#              port and opens it — runs JS/WebGL, no preview size caps. For a
#              built site or a self-contained figure export. NOT an http URL
#              (use open-url for those); path is confined to a workspace root.
#   relaunch — ask ONE frontend to respawn itself (ADR 0017): plain (exit 75,
#              re-stage + respawn) or --converge (exit 76: pull, rebuild,
#              daemon-pair re-ensure, respawn). With no --fe, the daemon
#              routes to the ACTIVE frontend; --fe <host> overrides it.
#              With no --fe and no active frontend (or an old daemon that
#              can't say), this script itself exits 2 with a `--fe` hint —
#              nothing bounces either way, but a silent no-op is refused.
#   repl     — run a .jl file (or eval code) in a workspace's persistent REPL
#              and print the COLLECTED output (stdout/stderr/value/error +
#              figure file paths). Unlike the other verbs this is a real
#              request/response op (repl.execute, ADR 0033): it blocks until
#              the run finishes (or --timeout, default 120s) and returns the
#              output. Non-destructive — runs in the REPL's current project,
#              no reset. Exit 0 on outcome:ok, 2 otherwise.
#   repl interrupt — stop the RUNNING eval without losing the kernel. The
#              least destructive recovery rung: the child keeps its compiled
#              packages, so you do NOT pay the multi-minute Makie/precompile
#              bill that --fresh costs. Reach for this BEFORE --fresh, and
#              before killing a pid by hand. The op stays readable while the
#              REPL is busy — but the interrupt lands at the eval's next
#              YIELD POINT (Ctrl-C semantics on a single thread), so a
#              non-yielding compute-bound eval (tight numeric loop, long
#              ccall/BLAS) may never take it; if repeated interrupts change
#              nothing, --fresh is the honest next rung. WORKSPACE-WIDE: it
#              interrupts THE eval running in <workspace>, whoever started it
#              (this CLI, the FE drawer, another session) — there is no
#              per-run scoping. Exit: 0 an eval was interrupted; 3 nothing to
#              interrupt (no eval running / no live kernel); 2 daemon error;
#              1 transport failure or no reply.
#   repl status — what the daemon already knows about a workspace's REPL:
#              lifecycle (not_started | starting | ready | dead) and the
#              workspace root it serves. NOTE the reported root is the
#              WORKSPACE's, not necessarily the child's active project — a
#              --fresh run restarts the child into the FILE's project, and a
#              workspace without Project.toml runs in the shim env; the wire
#              carries neither. Also NOT here: a busy/idle bit (the wire has
#              none), so status cannot confirm an interrupt landed — the
#              interrupt's own reply carries that. Omit <workspace> to list
#              every workspace whose REPL has been started. Use this BEFORE
#              ps/ss archaeology — and note it distinguishes "cannot reach
#              the daemon" from "the REPL is dead", which look identical from
#              the outside and mislead in opposite directions.
#   type     — a session types into a SIBLING row's pane, by workspace
#              id/label/slug (ADR 0042 amendment, 2026-09-07): request/
#              response (op pty.input), unlike pty.write (this connection's
#              OWN pty, fire-and-forget — the LLM-pane drawer's keystroke
#              path). Bytes are delivered LITERALLY to the row's own input
#              path — a headless attach that takes the capsule row's pen
#              ONLY long enough to type it, never resizing the pane. Text comes from the positional argument OR --stdin
#              (a leading `/` in --stdin text survives git-bash's argv
#              conversion this way); --enter appends the byte a terminal
#              itself sends for Enter, applied by the DAEMON (a literal CR
#              on the capsule row) — the text itself is NEVER altered to
#              carry it. --origin <who> names the
#              controller for the record's own controller-actor frames —
#              ATTRIBUTION, not authentication (the caller's CLAIMED
#              handle, same trust level as any hello client_id): default is
#              the caller's comm handle when comm-context.sh can derive
#              one, else the literal "sot-fe". READ BEFORE YOU WRITE: never send
#              a bare Enter (or anything) to a pane you have not read with
#              `screen` first — claude's own trust prompt defaults to "No,
#              exit", so a blind Enter can end a session instead of
#              advancing it. Prints `ok bytes=<n> runtime=<r> enter=<sent|not_sent|unknown>`.
#              `unknown` means the Enter may have reached the row: read its
#              screen before typing again;
#              exit 2 on a daemon-reported error (unknown workspace,
#              a not-ready or wedged capsule row, ...).
#   screen   — the CURRENT screen of a named row — no scrollback, no
#              history (op pty.screen). The capsule row is read by a WATCHER
#              attach that never takes the pen. Prints the screen's lines verbatim to stdout (one per
#              line, blank rows kept) and `cols=.. rows=.. cursor=r,c
#              runtime=..` to stderr; exit 2 on a daemon-reported error.
#              This is the READ half of the read-before-write policy above.
#   reauth   — move a LIVE capsule row to another claude account and RESUME
#              the same conversation there (ADR 0046 decision 6). The daemon
#              ends the row's current leg and starts a new claude in it with
#              that account's config dir, resuming this transcript by id
#              (--resume, read from the caller's own CLAUDE_CODE_SESSION_ID
#              -- never --continue, which reads a per-account selector the
#              new login does not share). The row keeps its id, slug, root
#              and declared handle; only which login it spends changes. It
#              moves the row it runs in, `$SOT_WORKSPACE_ID`, and no other row
#              can be named, because the conversation it resumes is this
#              session's own. The accept is written BEFORE the leg is killed,
#              so `ok reauth_accepted` is the last thing that session prints.
#              Refuses -- changing nothing -- an unset SOT_WORKSPACE_ID or a
#              second argument (both refused here, before anything is sent),
#              a row that is
#              not a capsule claude row, an account that is unknown or has
#              no login yet, the account the row already runs, a missing
#              transcript id, a transcript that account cannot open, and a
#              transcript that was not started in this row's root; a
#              refusal lists the accounts the daemon can see. Exit 0
#              accepted, 2 refused, 1 no reply. Read the
#              `reauth` skill first: everything in flight dies with the leg,
#              and the new account has no server-side cache for the
#              conversation.
#   version  — what build the daemon at --endpoint is, plus every attached
#              frontend and every capsule row's own PHASE, verbatim (ADR
#              0030 §8 decision 31, ADR 0043 decision 31). One
#              version.query + one workspace.list (never fans out to a
#              second daemon — pass --endpoint again for the other side).
#              Table rows: `<role>@<host>` per attached FE/bridge client
#              declaring a host (topology plan §F step 1 — a client with no
#              self-reported name prints as `client <id>` instead, and one
#              declaring a name but no host falls back to `<role> <name>`),
#              one row labeled by the RESOLVED
#              ENDPOINT with its app_version + lane_build + the daemon's own
#              declared host,
#              `row <slug>` per capsule workspace with its phase and no
#              derived verdict (this script never challenged the lane —
#              "foreign" already IS the verdict), and `comm scripts` from
#              the local $SOT_COMM_HOME/VERSION (`unknown` if absent). A
#              daemon predating version.query prints `unknown` there and
#              still exits 0; any OTHER failure, including a workspace.list
#              failure after a successful version.query, exits 2.
#
#   --fe <host>    scope delivery to the frontend on that host (sets the
#                  wire `target` to `fe@<host>`); absent = the daemon delivers to the ACTIVE
#                  frontend (whichever FE a person last touched), falling
#                  back to every FE (the badge floor) only when none is active.
#   --urgent       hint the FE to force-show now (preview/reveal); sets args.urgent.
#   --roi x,y,w,h   (preview) aim the viewport at a SOURCE-IMAGE-PIXEL rect (ADR-0022
#                  image.crop vocabulary; round-trippable). FE clamps to image bounds.
#                  The effective (clamped) rect echoes via a follow-up event, not this
#                  fire-and-forget ack (ADR-0025 2026-07-21 Update).
#   --caption <text>  (preview/reveal) figure caption shown UNDER the image in the
#                  preview pane — say what the figure IS, so the user reading the
#                  badge doesn't have to infer it from the filename. Images only
#                  (.png/.jpg/...); ignored for code/markdown/PDF previews. Sticky
#                  to that (workspace, file): it survives workspace switches and
#                  re-previews, so a cross-workspace badge still carries its caption
#                  when the user arrives minutes later. Re-previewing the same file
#                  WITHOUT --caption clears it. Capped at 300 chars by the FE
#                  (warned here); newlines/control chars collapse to spaces.
#   --boot         (goto) seed autostart so the FE boots ccb on the switch — the
#                  scriptable spawn->goto->boot primitive. Send DIRECTED (--fe
#                  <host>); a broadcast --boot would switch+boot on EVERY FE.
#   --fresh        (repl run) RESTART the workspace's persistent REPL into
#                  <path>'s project before including it (op repl.run_file,
#                  fresh:true) — the way to clear a STALE kernel from a backend
#                  session (e.g. after a struct/field change Revise can't
#                  hot-reload). Fire-and-forget: acks the bounce; the include's
#                  output streams to the FE drawer, not collected here. Without
#                  --fresh, `repl run` uses repl.execute (no reset, collects
#                  output) in the REPL's CURRENT project.
#   --endpoint     daemon address — unix:/path, ssh:target[/host], or (Windows
#                  only) pipe:\\.\pipe\name / pipe:name; else
#                  $SOT_FE_ENDPOINT / $SOT_SPAWN_ENDPOINT / $SOT_SOCKET /
#                  auto-detected from the running sotd daemon. On a Windows
#                  box, auto-detection prefers THAT BOX'S OWN local daemon
#                  (its named pipe) when one answers — so with no --endpoint
#                  a session reaches its own box's rows. To reach the
#                  BACKEND instead (its rows are a different daemon,
#                  ADR 0042 amendment decision 5), pass
#                  --endpoint ssh:<hub> explicitly — the box's own ssh
#                  child to it. There is no auto-routing by workspace name
#                  (a Windows box's local rows are not reachable from the
#                  backend at all; only the P4 bridge, not built here,
#                  could add that).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/comm-lib.sh"

if ! command -v jq >/dev/null 2>&1; then
    echo "ERROR: jq not found — needed to build the request payload." >&2; exit 1
fi

usage() {
    # Print the header usage/description block: comment lines from 10 down to
    # the first non-comment line (robust to the block growing).
    sed -n '10,$ { /^[^#]/q; p; }' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-1}"
}

CMD="${1:-}"; [ -n "$CMD" ] && shift || usage 1
ENDPOINT=""
FE=""          # --fe <host> → wire `target` fe@<host>
URGENT=false
CONVERGE=false   # --converge → relaunch exits 76 (pull + rebuild) instead of 75
BOOT=false
LEVEL=""
NOTIFY_WS=""
TIMEOUT=""     # repl: wall-clock budget in seconds
CODE=""        # repl eval: code (else read stdin)
READ_STDIN=false
ORIGIN=""      # repl: label shown in the user's drawer (default "session"); type: the controller id (default: the caller's comm handle, else "sot-fe")
ROI=""         # preview: source-px rect "x,y,w,h" to frame the image at (ADR-0022 vocab)
CAPTION=""     # preview/reveal: figure caption rendered under the image
CAPTION_SET=false  # distinguishes "--caption ''" (explicit clear) from "no --caption"
FRESH=false    # repl run: restart the persistent REPL into the file's project
ENTER=false    # type: append Enter after the literal text (the daemon types a CR on the capsule row)
POS=()         # positional args for the subcommand
while [ $# -gt 0 ]; do
    case "$1" in
        --fe)       FE="fe@$2"; shift 2 ;;
        --converge) CONVERGE=true; shift ;;
        --endpoint) ENDPOINT="$2"; shift 2 ;;
        --urgent)   URGENT=true; shift ;;
        --boot)     BOOT=true; shift ;;
        --fresh)    FRESH=true; shift ;;
        --level)    LEVEL="$2"; shift 2 ;;
        --ws)       NOTIFY_WS="$2"; shift 2 ;;
        # Validate here, once: TIMEOUT feeds the command bound (`sot_bounded`) and $((...)) math in
        # four different functions. Unvalidated, a non-numeric value made
        # `timeout` itself fail with its complaint discarded (2>/dev/null) and
        # the CLI then reported a FABRICATED "no response — it may have landed"
        # transport error for a frame that was never sent; `--timeout 0` means
        # "no limit" to GNU timeout and hung forever against a wedged daemon.
        --timeout)  case "${2:-}" in
                        ''|0|*[!0-9]*) echo "ERROR: --timeout expects a positive integer (seconds), got '${2:-}'" >&2; exit 1 ;;
                    esac
                    TIMEOUT="$2"; shift 2 ;;
        --code)     CODE="$2"; shift 2 ;;
        --stdin)    READ_STDIN=true; shift ;;
        --origin)   ORIGIN="$2"; shift 2 ;;
        --enter)    ENTER=true; shift ;;
        --roi)      ROI="$2"; shift 2 ;;
        --caption)  CAPTION="$2"; CAPTION_SET=true; shift 2 ;;
        -h|--help)  usage 0 ;;
        # Hard-error on an UNKNOWN flag instead of silently treating it as a
        # positional — a silent drop let `repl run --fresh` return a false "ok"
        # while ignoring --fresh entirely. Positionals never start with '-'.
        -?*)        echo "ERROR: unknown flag '$1'" >&2; usage 1 ;;
        *)          POS+=("$1"); shift ;;
    esac
done

source "$SCRIPT_DIR/sot-fe-request.sh"
source "$SCRIPT_DIR/sot-fe-repl.sh"
source "$SCRIPT_DIR/sot-fe-row.sh"
source "$SCRIPT_DIR/sot-fe-version.sh"

case "$CMD" in
    preview|reveal)
        WS="${POS[0]:-}"; PATH_ARG="${POS[1]:-}"
        [ -n "$WS" ] && [ -n "$PATH_ARG" ] || { echo "usage: sot-fe $CMD <workspace> <path> [--urgent] [--fe <host>] [--roi x,y,w,h] [--caption <text>]" >&2; exit 1; }
        # Keep the file nav INSIDE the repo: a node_id must be REPO-RELATIVE (the
        # daemon rejects absolute node_ids, and the FE tree positions its cursor by
        # relative id — an absolute path would show a "floating" file the nav can't
        # follow). Agents naturally hold an ABSOLUTE path of a file they just made,
        # so relativize it here against the caller's repo root. The strip is LEXICAL
        # (string prefix) — NOT `git -C <dir>` / realpath on the file — so a file
        # under a symlinked dir (e.g. data/results/myproject -> external storage) keeps its
        # in-repo relative path instead of resolving out to the external storage root.
        case "$PATH_ARG" in
            /*)
                _repo_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
                if [ -n "$_repo_root" ] && [ "$PATH_ARG" != "${PATH_ARG#"$_repo_root"/}" ]; then
                    PATH_ARG="${PATH_ARG#"$_repo_root"/}"
                else
                    echo "ERROR: '$PATH_ARG' is absolute and not under the current repo (${_repo_root:-<not in a repo>}). Pass a path relative to the workspace root — the file nav can only show files inside the repo." >&2
                    exit 1
                fi
                ;;
        esac
        ARGS="$(jq -nc --arg w "$WS" --arg p "$PATH_ARG" '{workspace:$w, path:$p}')"
        [ "$URGENT" = true ] && ARGS="$(printf '%s' "$ARGS" | jq -c '. + {urgent:true}')"
        # --roi x,y,w,h: aim the FE viewport at a SOURCE-IMAGE-PIXEL rect (ADR-0022
        # `image.crop` vocabulary, so a crop taken now round-trips to "look here
        # again" later — same rect = same region on any display). Validate strictly
        # CLI-side; the FE clamps to image bounds (zoom via png_zoom_max, pan-slack)
        # and, being fire-and-forget, does NOT echo the effective rect in this ack
        # (see ADR-0025 addendum) — a heavily-clamped aim surfaces FE-side.
        if [ -n "$ROI" ]; then
            IFS=',' read -r RX RY RW RH RREST <<< "$ROI"
            for _n in "$RX" "$RY" "$RW" "$RH"; do
                case "$_n" in
                    ''|*[!0-9]*) echo "ERROR: --roi expects x,y,w,h as non-negative integers (source-image px), got '$ROI'" >&2; exit 1 ;;
                esac
            done
            [ -z "$RREST" ] || { echo "ERROR: --roi expects exactly 4 comma-separated values x,y,w,h, got '$ROI'" >&2; exit 1; }
            # base-10 normalize (strips leading zeros so jq --argjson stays valid JSON)
            RX=$((10#$RX)); RY=$((10#$RY)); RW=$((10#$RW)); RH=$((10#$RH))
            { [ "$RW" -gt 0 ] && [ "$RH" -gt 0 ]; } || { echo "ERROR: --roi w and h must be > 0 (zero-area rect), got w=$RW h=$RH" >&2; exit 1; }
            ARGS="$(printf '%s' "$ARGS" | jq -c --argjson x "$RX" --argjson y "$RY" --argjson w "$RW" --argjson h "$RH" '. + {roi:{x:$x,y:$y,w:$w,h:$h}}')"
        fi
        # --caption <text>: a figure caption drawn UNDER the image, so a badged
        # figure says what it IS instead of making the user infer from the
        # filename. Neither an empty nor an over-long caption may cost the user
        # the BADGE — the badge is the point, the caption is the garnish — so
        # both degrade (warn + drop / warn + truncate) rather than exiting.
        if [ "$CAPTION_SET" = true ]; then
            _cap_trimmed="$(printf '%s' "$CAPTION" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
            if [ -z "$_cap_trimmed" ]; then
                echo "warn: --caption is empty — badging without a caption (omitting --caption on a re-preview is how you clear one)" >&2
            else
                # Warn here, but let the FE do the actual cutting: `${#var}` is
                # character-aware, so the LENGTH is right, but `cut -c` on this
                # platform counts BYTES — truncating a UTF-8 caption here split a
                # codepoint and produced invalid UTF-8 (and the wrong length: 400
                # chars became 149). The FE's truncate_caption cuts on character
                # boundaries, so it owns the cap; this is just early feedback.
                if [ "${#_cap_trimmed}" -gt 300 ]; then
                    echo "warn: --caption is ${#_cap_trimmed} chars — the frontend will truncate it to 300" >&2
                fi
                # MSYS2 argv-conversion guard (comm-lib.sh's sot_jq_rawfile):
                # a caption is free text and must never reach jq via --arg.
                _cap_file="$(sot_jq_rawfile "$_cap_trimmed")" || exit 1
                ARGS="$(printf '%s' "$ARGS" | jq -c --rawfile c "$_cap_file" '. + {caption:$c}')"
                rm -f "${_cap_file:?}"
            fi
        fi
        send_fe_command "$CMD" "$ARGS"
        # Use `if`, NOT `[ -n "$ROI" ] && echo` — with `set -e` and this being the
        # script's last statement, a false `[ -n "" ]` test (the no-ROI common case)
        # is exit status 1 and becomes the WHOLE script's exit code, so a perfectly
        # successful badge reported failure to careful callers (HS-TIRF, 2026-07-23:
        # open-url exits 0, preview exited 1 on identical success). `if` returns 0
        # when the condition is false.
        if [ -n "$ROI" ]; then
            echo "  roi requested (source px): x=$RX y=$RY w=$RW h=$RH — FE clamps to image bounds" >&2
        fi
        ;;
    docs)
        WS="${POS[0]:-}"; PATH_ARG="${POS[1]:-}"
        [ -n "$WS" ] && [ -n "$PATH_ARG" ] || { echo "usage: sot-fe docs <workspace> <abs-path> [--fe <host>]" >&2; exit 1; }
        # docs.open (the FE `W` key, backend-triggered) serves a LOCAL .html/site
        # from backend disk over the forwarded site_serve port and opens it in the
        # FE's real browser (runs JS/WebGL, no preview size caps). Unlike
        # preview/reveal it needs an ABSOLUTE backend path — the daemon stats it
        # RAW and confines it to any workspace root, so a repo-relative node_id
        # would be resolved against sotd's CWD and fail. Refuse a relative path
        # rather than send a broken one; do NOT relativize.
        # A Windows backend spells an absolute path with a drive letter, so
        # `/*` alone refused every legitimate local path on such a box. The
        # refusal is invisible on a Linux backend, where every path starts
        # with `/`. Both separators are accepted -- the daemon stats the
        # string raw and Windows takes either.
        case "$PATH_ARG" in
            /*) : ;;
            [A-Za-z]:/*) : ;;
            [A-Za-z]:\\*) : ;;
            *)  echo "ERROR: sot-fe docs needs an ABSOLUTE backend path -- /unix/style or C:\windows\style (docs.open stats it raw, not a repo-relative node_id)." >&2; exit 1 ;;
        esac
        # MSYS2 argv-conversion guard (comm-lib.sh's sot_jq_rawfile):
        # PATH_ARG is REQUIRED absolute here (the case above just enforced
        # it) and must never reach jq via --arg.
        _docs_path_file="$(sot_jq_rawfile "$PATH_ARG")" || exit 1
        ARGS="$(jq -nc --arg w "$WS" --rawfile p "$_docs_path_file" '{workspace:$w, path:$p}')"
        rm -f "${_docs_path_file:?}"
        send_fe_command docs "$ARGS"
        ;;
    goto)
        WS="${POS[0]:-}"
        [ -n "$WS" ] || { echo "usage: sot-fe goto <workspace> [--boot] [--fe <host>]" >&2; exit 1; }
        if [ "$BOOT" = true ]; then
            ARGS="$(jq -nc --arg w "$WS" '{workspace:$w, boot:true}')"
        else
            ARGS="$(jq -nc --arg w "$WS" '{workspace:$w}')"
        fi
        send_fe_command goto_workspace "$ARGS"
        ;;
    mode)
        MODE="${POS[0]:-}"
        [ -n "$MODE" ] || { echo "usage: sot-fe mode <mode> [--fe <host>]" >&2; exit 1; }
        # MODE is a short nav-mode token (files | modules | project | ...)
        # -- id-shaped, same allowlisted category as $WS/$want.
        ARGS="$(jq -nc --arg m "$MODE" '{mode:$m}')"
        send_fe_command goto_mode "$ARGS"
        ;;
    notify)
        TEXT="${POS[0]:-}"
        [ -n "$TEXT" ] || { echo "usage: sot-fe notify <text> [--level <l>] [--ws <workspace>] [--fe <host>]" >&2; exit 1; }
        # MSYS2 argv-conversion guard (comm-lib.sh's sot_jq_rawfile): TEXT
        # is free-text notification content and must never reach jq via
        # --arg.
        _notify_text_file="$(sot_jq_rawfile "$TEXT")" || exit 1
        ARGS="$(jq -nc --rawfile t "$_notify_text_file" '{text:$t}')"
        rm -f "${_notify_text_file:?}"
        [ -n "$LEVEL" ]     && ARGS="$(printf '%s' "$ARGS" | jq -c --arg l "$LEVEL" '. + {level:$l}')"
        [ -n "$NOTIFY_WS" ] && ARGS="$(printf '%s' "$ARGS" | jq -c --arg w "$NOTIFY_WS" '. + {workspace:$w}')"
        send_fe_command notify "$ARGS"
        ;;
    relaunch)
        # --fe is OPTIONAL: with none given, send_fe_command omits `target`
        # and the daemon resolves the active frontend itself, publishing
        # nothing at all when none is active (the send_fe_command check
        # above then exits 2 rather than reporting a false success).
        # --fe <host> still overrides it.
        ARGS="$(jq -nc --argjson c "$([ "$CONVERGE" = true ] && echo true || echo false)" '{converge:$c}')"
        send_fe_command relaunch "$ARGS"
        ;;
    open-url)
        URL="${POS[0]:-}"
        case "$URL" in
            http://*|https://*) : ;;
            *) echo "usage: sot-fe open-url <http(s)-url> [--fe <host>]  (http/https only)" >&2; exit 1 ;;
        esac
        ARGS="$(jq -nc --arg u "$URL" '{url:$u}')"
        send_fe_command open_url "$ARGS"
        ;;
    repl)
        SUB="${POS[0]:-}"
        case "$SUB" in
            run)
                WS="${POS[1]:-}"; FILE="${POS[2]:-}"
                [ -n "$WS" ] && [ -n "$FILE" ] || { echo "usage: sot-fe repl run <workspace> <path> [--fresh] [--timeout <s>]" >&2; exit 1; }
                if [ "$FRESH" = true ]; then
                    # Bounce the persistent REPL into <path>'s project, then include.
                    send_repl_run_file "$FILE" "$WS"
                else
                    # MSYS2 argv-conversion guard (comm-lib.sh's
                    # sot_jq_rawfile): FILE is a filesystem path and must
                    # never reach jq via --arg.
                    _run_file_input_file="$(sot_jq_rawfile "$FILE")" || exit 1
                    INPUT="$(jq -nc --rawfile p "$_run_file_input_file" '{kind:"run_file", path:$p}')"
                    rm -f "${_run_file_input_file:?}"
                    send_repl_execute "$INPUT" "$WS"
                fi
                ;;
            eval)
                WS="${POS[1]:-}"
                [ -n "$WS" ] || { echo "usage: sot-fe repl eval <workspace> (--code <c> | --stdin) [--timeout <s>]" >&2; exit 1; }
                EVAL_CODE=""
                if [ "$READ_STDIN" = true ]; then
                    EVAL_CODE="$(cat)"
                elif [ -n "$CODE" ]; then
                    EVAL_CODE="$CODE"
                else
                    echo "usage: sot-fe repl eval <workspace> (--code <c> | --stdin)  — code from --code or piped stdin" >&2; exit 1
                fi
                # MSYS2 argv-conversion guard (comm-lib.sh's
                # sot_jq_rawfile): EVAL_CODE is arbitrary Julia source and
                # must never reach jq via --arg.
                _eval_code_file="$(sot_jq_rawfile "$EVAL_CODE")" || exit 1
                INPUT="$(jq -nc --rawfile c "$_eval_code_file" '{kind:"eval", code:$c}')"
                rm -f "${_eval_code_file:?}"
                send_repl_execute "$INPUT" "$WS"
                ;;
            interrupt)
                WS="${POS[1]:-}"
                [ -n "$WS" ] || { echo "usage: sot-fe repl interrupt <workspace> [--timeout <s>]" >&2; exit 1; }
                send_repl_interrupt "$WS"
                ;;
            status)
                # <workspace> optional: bare `status` lists every started REPL.
                send_repl_status "${POS[1]:-}"
                ;;
            *) echo "usage: sot-fe repl run <workspace> <path> | sot-fe repl eval <workspace> (--code <c> | --stdin) | sot-fe repl interrupt <workspace> | sot-fe repl status [<workspace>]" >&2; exit 1 ;;
        esac
        ;;
    type)
        WS="${POS[0]:-}"
        [ -n "$WS" ] || { echo "usage: sot-fe type <workspace> [<text>] [--stdin] [--enter] [--origin <who>] [--timeout <s>]" >&2; exit 1; }
        if [ "$READ_STDIN" = true ]; then
            TEXT="$(cat)"
        else
            TEXT="${POS[1]:-}"
        fi
        [ -n "$TEXT" ] || [ "$ENTER" = true ] || { echo "usage: sot-fe type <workspace> [<text>] [--stdin] [--enter]  — nothing to send (no text and no --enter)" >&2; exit 1; }
        send_pty_input "$WS" "$TEXT" "$([ "$ENTER" = true ] && echo true || echo false)"
        ;;
    screen)
        WS="${POS[0]:-}"
        [ -n "$WS" ] || { echo "usage: sot-fe screen <workspace> [--timeout <s>]" >&2; exit 1; }
        send_pty_screen "$WS"
        ;;
    reauth)
        [ "${#POS[@]}" -le 1 ] || { echo "ERROR: reauth moves only the row it runs in (\$SOT_WORKSPACE_ID); it takes one argument, the account. Nothing was sent." >&2; exit 2; }
        ACCOUNT="${POS[0]:-}"
        [ -n "$ACCOUNT" ] || { echo "usage: sot-fe reauth <account> [--timeout <s>]  -- name the account; this verb never guesses which login was meant" >&2; exit 1; }
        send_workspace_reauth "$ACCOUNT"
        ;;
    version)
        send_version
        ;;
    -h|--help|help) usage 0 ;;
    *) echo "ERROR: unknown subcommand '$CMD'" >&2; usage 1 ;;
esac
