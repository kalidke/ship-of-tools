#!/bin/bash
# ccx — start a comm-aware CODEX session for any project (ADR 0031).
#
# Codex counterpart of ccb. Unlike ccb (whose claude session bootstraps its
# own receive path via the /sot-session-start skill — ADR 0049 is the design
# of record there too, daemon-woken with nothing to arm),
# codex has NO background-wake primitive — so ccx does the comm bootstrap
# DETERMINISTICALLY in the launcher before exec'ing codex:
#   1. join sot-comm as this session's handle: the one its self file names
#      (a row keeps the handle it was created with), else derived; no
#      launcher chooses one (decision 0031).
# Then exec codex, which reads AGENTS.md (identity, comm CLI usage, state
# discipline) from the repo/checkout natively.
#
# Source of truth: agents/codex/bin/ccx in Ship of Tools, deployed to
# ~/.local/bin by `ShipTools.update_comm()`. Edit it there.

# Same env scrub as ccb: a daemon-spawned row inherits the daemon's env,
# which may carry another agent's nesting markers.
unset CLAUDE_CODE_FORK_SUBAGENT CLAUDE_CODE_CHILD_SESSION CLAUDE_CODE_TEAMMATE_MODE CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS CLAUDECODE AI_AGENT CLAUDE_CODE_SESSION_ID

RESUME_ID=""; FRESH=0; CONTINUE=0; CAPSULE=0; MARKER=""; QUEUE=0; QUEUE_THREAD=""; QUEUE_LINE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --queue) QUEUE=1; QUEUE_THREAD="$2"; QUEUE_LINE="$3"; shift 2 ;;
        --fresh) FRESH=1 ;;
        --resume) RESUME_ID="$2"; shift ;;
        --continue) CONTINUE=1 ;;
        --selection-marker) MARKER="$2"; shift ;;
        --capsule) CAPSULE=1 ;;
    esac
    shift
done

# --capsule is the daemon's own leg for a row, which keeps its row's selection and binding files; a ccx started by hand inside a
# row has the outer row's files inherited and drops them, as the nesting markers above are.
[ "$CAPSULE" = 1 ] || unset SOT_SELECTION_FILE SOT_CODEX_THREAD_FILE

# Daemon-spawned rows lack a login PATH (ADR 0023 gotcha): put ~/.local/bin
# on it, and resolve codex by full path — it typically lives in an nvm bin
# dir that the daemon's env has never heard of.
export PATH="$HOME/.local/bin:$PATH"
CODEX_BIN="$(command -v codex 2>/dev/null || true)"
if [ -z "$CODEX_BIN" ]; then
    for d in "$HOME"/.nvm/versions/node/*/bin; do
        [ -x "$d/codex" ] && CODEX_BIN="$d/codex"
    done
fi
if [ -z "$CODEX_BIN" ]; then
    [ "$QUEUE" = 0 ] || { echo "ccx: no queue: codex not found" >&2; exit 69; }
    echo "ccx: codex not found (install codex-cli and run 'codex login')" >&2
    exec bash   # leave a usable shell in the pane rather than dying silently
fi
# codex is a node script (#!/usr/bin/env node): the daemon-spawned row's
# PATH has no nvm dir, so exec'ing codex dies on a missing `node` — pane and
# session vanish silently (the 2026-07-05 boot_failed class). node lives
# next to codex in the nvm bin dir; put that dir on PATH.
export PATH="$(dirname "$CODEX_BIN"):$PATH"

# --queue <conversation id> <line>: the daemon's mail wake for a Codex row (messaging's contract, Waking). The binary
# and its home are the ones resolved above, as for the row's leg; nothing is joined, trusted, written or started.
# Codex's own queue command runs only when its help names both options. A refusal before that is the launcher's own:
# status 69 and a line that starts `ccx: no queue:`, and nothing was stored. Anything after it is Codex's.
if [ "$QUEUE" = 1 ]; then
    help="$("$CODEX_BIN" queue --help </dev/null 2>/dev/null)" || help=
    case "$help" in *--thread*) case "$help" in *--message*)
        exec "$CODEX_BIN" queue --thread "$QUEUE_THREAD" --message "$QUEUE_LINE" </dev/null ;;
    esac ;; esac
    echo "ccx: no queue: $CODEX_BIN has no queue command that takes --thread and --message" >&2
    exit 69
fi

COMM="${SOT_COMM_HOME:-$HOME/.sot-comm}/bin"

# The join takes the handle; comm-context names it back for the first prompt (a subshell: its lines set variables
# codex must not inherit). A session the join gave no handle still starts, and says so.
HANDLE=""
if [ -x "$COMM/comm-join.sh" ]; then
    "$COMM/comm-join.sh" >/dev/null 2>&1 || true
    HANDLE="$( eval "$("$COMM/comm-context.sh" 2>/dev/null)" 2>/dev/null; printf '%s' "${NAME:-}" )"
    [ -n "$HANDLE" ] || echo "ccx: comm-join.sh gave this session no handle; it sends and reads no mail" >&2
fi

# Pre-trust the workspace dir (idempotent): without this codex blocks on an
# interactive "do you trust this directory" prompt on every first visit —
# fatal in a daemon-booted row nobody is watching. Trusting is correct by
# construction here: the daemon only creates workspaces at user-chosen roots.
# Honor $CODEX_HOME: a host that points it elsewhere (e.g. machine-local, to
# keep codex's flock() off NFS) reads a DIFFERENT config, so writing this to
# ~/.codex would be a no-op nobody notices.
CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEX_CFG="$CODEX_HOME_DIR/config.toml"
CWD_ABS="$(pwd -P)"
if ! grep -qF "[projects.\"$CWD_ABS\"]" "$CODEX_CFG" 2>/dev/null; then
    printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$CWD_ABS" >> "$CODEX_CFG"
fi

# First-turn brief: identity + where the conventions live. AGENTS.md carries
# the full contract; this just anchors the session's handle and backlog.
# --sandbox danger-full-access: ccx is deliberately BROADER than ccb here,
# not equivalent to it — codex's comm files (registry, inbox cursors,
# comm-send) need unrestricted filesystem access that a read-only $HOME
# sandbox breaks. Without it, observed live: comm-poll.sh died on a
# read-only cursor file.
# --dangerously-bypass-approvals-and-sandbox: full access AND no trust /
# approval prompts (again broader than ccb's posture, not matched to it) —
# a [projects] trust_level entry alone still left an
# interactive trust prompt blocking daemon-booted rows. exec (not a child)
# so the row's foreground command reads node/codex and the daemon's boot
# poll detects it; with node's dir on PATH the exec-death class is gone.
# --dangerously-bypass-hook-trust: our state hooks ship as the sot-comm
# plugin; trust is persisted per hook hash, so any hook-script update would
# otherwise leave state reporting disabled until a human re-trusts in /hooks.
# The hooks are ours by construction, so the bypass keeps daemon-spawned
# sessions reporting. codex runs a hook when `bypass_hook_trust || trusted`, so
# the flag really does execute an untrusted hook — a /hooks panel reading
# Active=0 reflects PERSISTED trust and does not predict behaviour under this
# flag. See comm/adapters/codex/hooks.README.md.
# Every ccx starts FRESH; only --continue scans for this folder's last conversation (--resume <id> names one), and
# --fresh overrides --continue. --capsule does not change the conversation choice; the daemon keeps passing it because an older
# installed ccx starts fresh only with --capsule.
SCAN=0
[ "$CONTINUE" = 1 ] && [ "$FRESH" = 0 ] && [ -z "$RESUME_ID" ] && SCAN=1
if [ "$SCAN" = 1 ]; then
    for f in $(ls -t "$CODEX_HOME_DIR"/sessions/*/*/*/rollout-*.jsonl 2>/dev/null | sed -n 1,300p); do
        if head -c 4096 "$f" | grep "\"cwd\":\"$PWD\"" >/dev/null; then
            RESUME_ID="$(head -c 4096 "$f" | grep -o '"id":"[0-9a-f-]\{36\}"' | sed -n 1p | cut -d'"' -f4)"
            break
        fi
    done
fi
# The handoff line from the comm library's one rule (a subshell: the library sets umask 077, which codex must not inherit).
HANDOFF_LINE="$( . "$COMM/comm-lib.sh" 2>/dev/null && sot_comm handoff-line "$HANDLE" )" ||
    echo "ccx: the comm library did not load from $COMM; the first prompt names no handoff" >&2
PROMPT="You are the comm-aware agent${HANDLE:+ @$HANDLE} on the sot-comm network. House conventions are in your GLOBAL $CODEX_HOME_DIR/AGENTS.md (plus the project's own AGENTS.md when it has one, and \$SOT_MANUAL/docs/USING.md for product help). Then run: $COMM/comm-poll.sh — and handle what it prints. An idle row is woken by the typed line '[sot-comm] you have mail: run comm-poll.sh'; run it and handle what it prints.${HANDOFF_LINE:+ $HANDOFF_LINE}"
# Request the inline renderer so conversation history can enter the terminal's scrollback.
set -- --dangerously-bypass-approvals-and-sandbox --dangerously-bypass-hook-trust --no-alt-screen -c 'plugins.sot-row@sot-local.enabled=true'
help_command=()
if [ -n "$RESUME_ID" ]; then
    help_command=(resume)
    set -- resume "$RESUME_ID" "$@"
    PROMPT="Your pane was restarted; this is the same conversation resumed. $PROMPT Then continue exactly where you left off."
fi
# Probe the command being launched. Older Codex versions can still start with their usual arguments.
if { "$CODEX_BIN" "${help_command[@]}" --no-daemon --help; } </dev/null >/dev/null 2>&1; then
    set -- "$@" --no-daemon
fi
stamped=
if [ "$CAPSULE" = 1 ] && [ -n "$MARKER" ] && [ -n "${SOT_SELECTION_FILE:-}" ] && [ -f "$COMM/sot-selection-hook.sh" ] && [ -x "$COMM/sot-selection-hook.sh" ]; then
    versions=("$CODEX_HOME_DIR"/plugins/cache/sot-local/sot-row/*)
    root=${versions[0]}
    manifest="$root/.codex-plugin/plugin.json"
    hooks="$root/hooks/hooks.json"
    command='hook="${SOT_COMM_HOME:-$HOME/.sot-comm}/bin/sot-selection-hook.sh"; if [ -n "${SOT_SELECTION_FILE:-}" ] && [ -f "$hook" ] && [ -x "$hook" ]; then exec "$hook"; fi; cat >/dev/null 2>&1; exit 0'
    binding='hook="${SOT_COMM_HOME:-$HOME/.sot-comm}/bin/sot-codex-binding-hook.sh"; if [ -n "${SOT_CODEX_THREAD_FILE:-}" ] && [ -f "$hook" ] && [ -x "$hook" ]; then exec "$hook"; fi; cat >/dev/null 2>&1; exit 0'
    recovery='hook="${SOT_COMM_HOME:-$HOME/.sot-comm}/bin/sot-codex-session-start-hook.sh"; if [ -n "${SOT_CODEX_THREAD_FILE:-}" ] && [ -f "$hook" ] && [ -x "$hook" ]; then exec "$hook"; fi; cat >/dev/null 2>&1; exit 0'
    previous= isolated=0 enabled=0
    for arg in "$@"; do
        [ "$arg" != --no-daemon ] || isolated=1
        if [ "$previous" = -c ] && [ "$arg" = 'plugins.sot-row@sot-local.enabled=true' ]; then enabled=1; fi
        previous=$arg
    done
    if [ "$isolated" = 1 ] && [ "$enabled" = 1 ] &&
       [ "${#versions[@]}" = 1 ] && [ -f "$manifest" ] && [ -f "$hooks" ] &&
       jq -se --arg version "${root##*/}" 'length == 1 and
         (.[0] | .name == "sot-row" and .version == $version and .hooks == "./hooks/hooks.json")' "$manifest" >/dev/null &&
       jq -se --arg cmd "$command" --arg bind "$binding" --arg start "$recovery" '
         def hook($c): {type:"command",command:$c};
         . == [{hooks:{SessionStart:[{hooks:[hook($bind),hook($start)]}],UserPromptSubmit:[{hooks:[hook($cmd),hook($bind)]}]}}]' "$hooks" >/dev/null &&
       : > "$MARKER"; then
        stamped=$MARKER
        shopt -s execfail
    fi
fi
exec "$CODEX_BIN" "$@" "$PROMPT"
status=$?
[ -z "$stamped" ] || rm -f -- "$stamped" || exit 1
exit "$status"
