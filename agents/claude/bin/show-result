#!/usr/bin/env bash
# show-result — surface a result you just produced in the user's Ship of Tools
# nav/preview pane. A thin, friction-free wrapper over `sot-fe preview`
# (op::FE_COMMAND, ADR 0025) that auto-discovers your workspace slug, so a session
# can run ONE short command right after it saves an artifact — "producing it ==
# surfacing it." See the /show-result skill for the discipline.
#
# Usage:
#   show-result <path>                        # BADGE it (default; non-intrusive — PREFERRED)
#   show-result <page.html>                   # a page under the row's folder: says how to OFFER it to the
#                                             # person's Queue (Page: on the closing marker line); opens nothing
#   show-result <path> --caption "<text>"     # images: a caption band UNDER the figure
#                                             # (reserved space, never covers the plot);
#                                             # sticky per (workspace, file) — re-badging
#                                             # without --caption clears it
#
# <path> is workspace-relative (an absolute path under the workspace auto-relativizes).
# Bind it to production, e.g. in Julia:  save(p, fig); run(`show-result $p`)
set -euo pipefail

case "${1:-}" in
  ""|-h|--help)
    # Comment lines from 2 down to the first non-comment — robust to the usage
    # block growing (a hardcoded end line silently truncated --help when
    # --caption was added). Same idiom as sot-fe's usage().
    sed -n '2,$ { /^[^#]/q; p; }' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac

REL="$1"; shift

# Discover the workspace slug — never guess it. Requires the backend-stamped
# SOT_WORKSPACE.
WS="${SOT_WORKSPACE:-}"
if [ -z "$WS" ]; then
  echo "show-result: workspace slug unknown — SOT_WORKSPACE is unset." >&2
  exit 3
fi

SFE="$HOME/.sot-comm/bin/sot-fe"
[ -x "$SFE" ] || SFE="sot-fe"   # fall back to PATH

# Near-blank guard (best-effort, never blocks): a recurring trap is badging a
# visually-empty image blind — e.g. full-field scientific renders (fine features in a
# µm field) read as solid black at overview scale. When ImageMagick is
# available, warn loudly on a low pixel-stddev image so the agent VIEWS it
# before the user does (2026-07-03 incident: three near-black renders badged
# in a row, never viewed). Warning only — dark-but-legitimate images exist,
# and the agent gates.
case "$(printf '%s' "$REL" | tr '[:upper:]' '[:lower:]')" in
  *.png|*.jpg|*.jpeg|*.gif|*.webp|*.tif|*.tiff)
    IM="$(command -v magick || command -v convert || true)"
    if [ -n "$IM" ] && [ -f "$REL" ]; then
      stddev="$("$IM" "$REL" -format "%[fx:standard_deviation]" info: 2>/dev/null || true)"
      case "$stddev" in
        0.0*|0)
          if awk -v s="${stddev:-1}" 'BEGIN{exit !(s < 0.02)}'; then
            echo "note: '$REL' looks NEAR-BLANK (pixel stddev=$stddev < 0.02). The badge still goes through" >&2
            echo "      (showing is unconditional) — VIEW it with Read and tell the user what they're looking at;" >&2
            echo "      if a cropped/panel export is the legible one, badge that too and say which is which." >&2
          fi ;;
      esac
    fi ;;
esac

# A page is offered, never opened (the maintainer, 2026-10-31: "things are still posting pages directly to browser, and
# not to radiant queue"): the session ends its reply's closing marker line with `Page: <absolute path>`, the daemon
# keeps that page on the row's latest stamp, and the person's Queue opens it from its card. The Queue serves only a page
# under this row's own project folder (pages' open verb), so a page elsewhere is refused here. A person who asks to see
# a page now gets it from `sot-fe docs <workspace> <absolute path>`, which this wrapper never runs.
case "$(printf '%s' "$REL" | tr '[:upper:]' '[:lower:]')" in
  *.html|*.htm)
    case "$REL" in
      /*) ABS="$REL" ;;
      *) ABS="${SOT_WORKSPACE_ROOT:-$PWD}/$REL" ;;
    esac
    PAGE="$(cd "$(dirname -- "$ABS")" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "$(basename -- "$ABS")" || true)"
    [ -n "$PAGE" ] || PAGE="$ABS"
    ROOT=""
    [ -n "${SOT_WORKSPACE_ROOT:-}" ] && ROOT="$(cd "$SOT_WORKSPACE_ROOT" 2>/dev/null && pwd -P || true)"
    if [ -n "$ROOT" ]; then
      case "$PAGE" in
        "$ROOT"/*)
          echo "show-result: offered, not opened. End your reply's closing marker line with  Page: $PAGE"
          echo "  (SITREP-QUESTION when you ask, SITREP-WAITING while you wait, SITREP when you close): your person's Queue"
          echo "  shows it as a card and opens it there. Only if they asked to see it now: sot-fe docs $WS $PAGE"
          exit 0 ;;
      esac
    fi
    echo "show-result: not offered: the Queue opens only a page under this row's project folder (${ROOT:-unknown})." >&2
    echo "  Write the page there, then end your closing marker line with  Page: <its absolute path>" >&2
    exit 2 ;;
esac

# The badge floor is the only path for everything else — we never force-switch the user's view.
# Any extra flags pass through to `sot-fe preview`.
exec "$SFE" preview "$WS" "$REL" "$@"
