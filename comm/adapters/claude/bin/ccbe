#!/bin/bash
# ccbe — start (or resume) a comm-aware Ship of Tools *backend* Claude session.
#
# ADR 0046 decision 4: identical to `ccb` now — the daemon's own
# `agent_argv`/`claude_recipe` (rust/backend/src/capsule_workspace.rs) is the
# ONE owner of the launch recipe, and `/sot-be-session-start` is an alias of
# `/sot-session-start` (CLAUDE.md: "the skill is one skill"), so there is no
# separate recipe left for this script to carry. Kept as its own file only
# because the tmux surface it names in its own history is still retiring by
# attrition; `ccbe` is deleted together with that surface, not before.
#
# Usage:
#   ccbe                # fresh comm-aware backend session
#   ccbe --continue     # resume the last session AND re-arm comm. This is the
#                       # deaf-on-restart fix: harness Monitors do NOT survive
#                       # `claude --continue`, so the bootstrap must re-run.
#   ccbe <flags...>     # any extra flags are forwarded to claude, before the skill
#
# `sotd agent-exec` places the skill LAST (after every flag given here), so
# it lands as claude's first-turn prompt AFTER any --continue / flags.
# Source of truth: comm/adapters/claude/bin/ccbe in Ship of Tools, deployed to
# ~/.local/bin by `ShipTools.update_comm()`. Edit it there, not in ~/.local/bin.
sotd_bin="${SOTD_BIN:-}"
[ -n "$sotd_bin" ] && [ -x "$sotd_bin" ] || sotd_bin="$(command -v sotd 2>/dev/null || true)"
[ -n "$sotd_bin" ] && [ -x "$sotd_bin" ] || sotd_bin="$HOME/.local/share/sot/bin/sotd"
[ -x "$sotd_bin" ] || sotd_bin="$HOME/.local/bin/sotd"
if [ ! -x "$sotd_bin" ]; then
    echo "ccbe: sotd not found (checked \$SOTD_BIN, PATH, and the install paths)" >&2
    exit 1
fi
exec "$sotd_bin" agent-exec claude "$@"
