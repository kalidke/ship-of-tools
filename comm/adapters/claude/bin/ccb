#!/bin/bash
# ccb — start (or resume) a comm-aware backend Claude session for ANY project.
#
# ADR 0046 decision 4: the launch recipe (the scrub list, the ~/.local/bin
# PATH rule, the flag shape) has ONE owner now — the daemon's own
# `agent_argv`/`claude_recipe` (rust/backend/src/capsule_workspace.rs) — and
# this script only resolves `sotd` and execs THROUGH it via `sotd agent-exec`.
# `sotd agent-exec claude` bakes in `--permission-mode auto` and appends the
# /sot-session-start bootstrap skill last, so the session comes up already
# RECEIVING fast-comm (durable relay listener + the inbox Monitor that wakes
# it). Project-agnostic: use it for any backend session that should receive
# cross-session messages.
#
# For Ship of Tools *backend* sessions use `ccbe` instead (currently
# identical — see its own header).
#
# Usage:
#   ccb               # fresh comm-aware session
#   ccb --continue    # resume the last session AND re-arm comm (harness Monitors
#                     # do NOT survive `claude --continue`, so the bootstrap re-runs)
#   ccb <flags...>    # any extra flags are forwarded to claude, before the skill
#
# `sotd agent-exec` places the skill LAST (after every flag given here), so
# it lands as claude's first-turn prompt AFTER any --continue / flags.
# Source of truth: comm/adapters/claude/bin/ccb in Ship of Tools, deployed to
# ~/.local/bin by `ShipTools.update_comm()`. Edit it there, not in ~/.local/bin.
sotd_bin="${SOTD_BIN:-}"
[ -n "$sotd_bin" ] && [ -x "$sotd_bin" ] || sotd_bin="$(command -v sotd 2>/dev/null || true)"
[ -n "$sotd_bin" ] && [ -x "$sotd_bin" ] || sotd_bin="$HOME/.local/share/sot/bin/sotd"
[ -x "$sotd_bin" ] || sotd_bin="$HOME/.local/bin/sotd"
if [ ! -x "$sotd_bin" ]; then
    echo "ccb: sotd not found (checked \$SOTD_BIN, PATH, and the install paths)" >&2
    exit 1
fi
exec "$sotd_bin" agent-exec claude "$@"
